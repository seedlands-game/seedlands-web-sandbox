{
  "name": "seedlands-workspace",
  "description": "A playable browser voxel sandbox and technical foundation for the Seedlands world project.",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://seedlands-game.github.io/seedlands-web-sandbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedlands-game/seedlands-web-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/seedlands-game/seedlands-web-sandbox/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @seedlands/web dev",
    "build": "node scripts/harness/artifact.mjs --build",
    "build:web": "pnpm --filter @seedlands/web build",
    "typecheck": "pnpm --filter @seedlands/kernel typecheck && pnpm --filter @seedlands/stdlib typecheck && pnpm --filter @seedlands/playbook-classic typecheck && pnpm --filter @seedlands/eslint-plugin typecheck && pnpm --filter @seedlands/web typecheck && pnpm --filter @seedlands/agent-server typecheck && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "lint:paths": "ls-lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/harness/run.mjs --stage tests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:ci": "pnpm test:coverage --maxWorkers=1",
    "verify:static": "pnpm verify:affected",
    "verify:static:ci": "pnpm verify:affected",
    "ssg:update": "pnpm --filter @seedlands/web ssg:update",
    "ssg:check": "pnpm --filter @seedlands/web ssg:check",
    "server:headless": "node scripts/server-headless.mjs",
    "preview": "pnpm --filter @seedlands/web preview",
    "prepare": "husky",
    "wasm:simd:build": "node scripts/build-simd-experiment.mjs",
    "rust:check": "node scripts/check-rust-kernel-boundary.mjs",
    "wasm:simd:ab": "node scripts/run-simd-experiment.mjs",
    "wasm:simd:report": "node scripts/summarize-simd-experiment.mjs",
    "wasm:rust:build": "node scripts/rust-kernel-artifact.mjs --build",
    "wasm:rust:verify": "node scripts/rust-kernel-artifact.mjs",
    "perf:adoption:freeze": "node scripts/freeze-adoption-builds.mjs",
    "perf:adoption:summary": "node scripts/summarize-adoption-experiment.mjs",
    "build:packs": "node scripts/build-gameplay-packs.mjs",
    "build:agent": "pnpm --filter @seedlands/agent-server build",
    "agent:dev": "pnpm build:agent && pnpm --filter @seedlands/agent-server start",
    "harness:plan": "node scripts/harness/plan.mjs",
    "verify:affected": "node scripts/harness/run.mjs --stage affected",
    "verify:all": "node scripts/harness/run.mjs --stage all",
    "harness:classic": "node scripts/harness/run.mjs --stage classic",
    "harness:artifact": "node scripts/harness/artifact.mjs",
    "bench:local": "node scripts/benchmark-window.mjs -- node scripts/harness/local-benchmark.mjs",
    "bench:runtime": "node scripts/benchmark-window.mjs -- node scripts/harness/run.mjs --stage runtime",
    "harness:baseline:candidate": "node scripts/harness/baseline.mjs",
    "harness:baseline:accept": "node scripts/harness/baseline.mjs --accept",
    "test:all": "node scripts/harness/run.mjs --stage tests --all",
    "test:eslint": "pnpm --filter @seedlands/eslint-plugin test",
    "test:e2e": "pnpm harness:classic",
    "harness": "pnpm verify:all",
    "harness:benchmark": "pnpm bench:local --owner stdlib-world"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/openai": "1.5.11",
    "@ls-lint/ls-lint": "2.3.1",
    "@midscene/cli": "^1.12.3",
    "@playwright/test": "1.62.1",
    "@seedlands/cognition-protocol": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "langchain": "1.5.10",
    "pg": "8.23.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "playcanvas": "^2.21.4",
    "svelte": "^5.57.0",
    "tone": "^15.1.22",
    "@seedlands/eslint-plugin": "workspace:*",
    "@seedlands/kernel": "workspace:*",
    "@seedlands/stdlib": "workspace:*",
    "@seedlands/playbook-classic": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,svelte}": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --check"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
