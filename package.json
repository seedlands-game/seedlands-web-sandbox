{
  "name": "seedlands-workspace",
  "description": "A playable browser voxel sandbox and technical foundation for the Seedlands world project.",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://seedlands-game.github.io/seedlands-web-sandbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedlands-game/seedlands-web-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/seedlands-game/seedlands-web-sandbox/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @seedlands/web dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @seedlands/web build",
    "typecheck": "pnpm --filter @seedlands/game-core typecheck && pnpm --filter @seedlands/web typecheck && pnpm --filter @seedlands/node-server typecheck && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.active-node-tests.json --noEmit",
    "lint": "eslint .",
    "lint:paths": "ls-lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:active-node:critical": "vitest run --config vitest.active-node.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --maxWorkers=1",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:regression": "playwright test tests/e2e/regression changes/2026-09-07-loading-performance/e2e/loading-performance.spec.ts changes/2026-09-07-prerendered-start-screen/e2e/prerendered-start-screen.spec.ts changes/2026-09-08-node-monorepo/e2e/web-package-runtime.spec.ts",
    "test:web-node-playable": "pnpm build:server && vitest run tests/server/network-playable-protocol.test.ts tests/node/node-network-options.test.ts tests/node/node-authority-publication-listener.test.ts tests/node/node-playable-offline-runtime.test.ts tests/node/node-playable-network-integration.test.ts tests/node/node-playable-network-session.test.ts tests/client/remote-authority-client.test.ts tests/client/remote-authority-mesh-mirror.test.ts tests/app/playable-worker-session.test.ts tests/app/initial-playable-area-priority.test.ts tests/app/world-initial-playable-area.test.ts && playwright test changes/2026-09-08-web-node-playable/e2e/web-node-playable.spec.ts changes/2026-09-08-web-node-playable/e2e/graphics-identity-failure.spec.ts",
    "test:web-node-playable:browser": "playwright test changes/2026-09-08-web-node-playable/e2e/web-node-playable.spec.ts changes/2026-09-08-web-node-playable/e2e/graphics-identity-failure.spec.ts",
    "test:e2e:benchmark": "playwright test tests/e2e/benchmark",
    "test:e2e:macro-map": "playwright test tests/e2e/regression/macro-map.spec.ts",
    "verify:static": "pnpm ssg:check && pnpm format:check && pnpm lint && pnpm lint:paths && pnpm test:coverage && pnpm typecheck",
    "verify:static:ci": "pnpm ssg:check && pnpm format:check && pnpm lint && pnpm lint:paths && pnpm test:coverage:ci && pnpm typecheck",
    "ssg:update": "pnpm --filter @seedlands/web ssg:update",
    "ssg:check": "pnpm --filter @seedlands/web ssg:check",
    "harness:benchmark": "node --expose-gc scripts/run-harness.mjs",
    "harness:baseline": "pnpm test && pnpm build && node scripts/run-playwright-harness.mjs --aggregate --baseline",
    "harness:e2e": "node scripts/run-playwright-harness.mjs",
    "harness:macro-map": "pnpm test:e2e:macro-map",
    "harness": "pnpm test && pnpm build && node scripts/run-playwright-harness.mjs --aggregate",
    "server:headless": "node scripts/server-headless.mjs",
    "preview": "pnpm --filter @seedlands/web preview",
    "midscene:verify-model": "midscene model verify",
    "midscene:smoke": "midscene ./changes/2026-09-03-foundation-hardening/midscene/voxel-sandbox.smoke.yaml --dotenv-override --summary ./midscene_run/summary.json",
    "prepare": "husky",
    "build:server": "pnpm --filter @seedlands/node-server build",
    "verify:node-isolation": "node scripts/verify-node-package-isolation.mjs",
    "verify:web-node-playable-dist": "pnpm build:server && node scripts/verify-web-node-playable-dist.mjs",
    "server:dedicated": "pnpm --filter @seedlands/node-server start",
    "wasm:simd:build": "node scripts/build-simd-experiment.mjs",
    "rust:check": "node scripts/check-rust-kernel-boundary.mjs",
    "wasm:simd:ab": "node scripts/run-simd-experiment.mjs",
    "wasm:simd:report": "node scripts/summarize-simd-experiment.mjs",
    "wasm:rust:build": "node scripts/rust-kernel-artifact.mjs --build",
    "wasm:rust:verify": "node scripts/rust-kernel-artifact.mjs",
    "perf:adoption:freeze": "node scripts/freeze-adoption-builds.mjs",
    "perf:adoption:summary": "node scripts/summarize-adoption-experiment.mjs",
    "test:pr15:integration": "playwright test changes/2026-09-08-pr15-main-sync/e2e/asset-package-integration.spec.ts",
    "experiment:web-node-render-contention": "node changes/2026-09-08-web-node-playable/e2e/run-render-contention-experiment.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@midscene/cli": "^1.12.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "playcanvas": "^2.21.4",
    "svelte": "^5.57.0",
    "tone": "^15.1.22"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,svelte}": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --check"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
