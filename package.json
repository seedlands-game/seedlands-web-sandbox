{
  "name": "seedlands-workspace",
  "description": "A playable browser voxel sandbox and technical foundation for the Seedlands world project.",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://seedlands-web-sandbox.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedlands-game/seedlands-web-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/seedlands-game/seedlands-web-sandbox/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @seedlands/web dev",
    "build": "node scripts/harness/artifact.mjs --build",
    "build:web": "pnpm --filter @seedlands/web build",
    "typecheck": "pnpm --filter @seedlands/kernel typecheck && pnpm --filter @seedlands/stdlib typecheck && pnpm --filter @seedlands/playbook-classic typecheck && pnpm --filter @seedlands/eslint-plugin typecheck && pnpm --filter @seedlands/web typecheck && pnpm --filter @seedlands/agent-server typecheck && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.classic-tests.json --noEmit",
    "lint": "eslint .",
    "lint:paths": "ls-lint",
    "format": "prettier --write .",
    "format:check": "node scripts/check-frozen-evidence.mjs && prettier --check .",
    "test": "pnpm test:deterministic",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:ci": "pnpm test:coverage --maxWorkers=1",
    "test:deterministic": "pnpm test:kernel && pnpm test:stdlib",
    "test:kernel": "pnpm exec vitest run --config packages/kernel/vitest.config.ts --maxWorkers=2",
    "test:stdlib": "pnpm exec vitest run --config packages/stdlib/vitest.config.ts --maxWorkers=2",
    "test:kernel:ci": "pnpm exec vitest run --config packages/kernel/vitest.config.ts --maxWorkers=1",
    "test:stdlib:ci": "pnpm exec vitest run --config packages/stdlib/vitest.config.ts --maxWorkers=1",
    "test:deterministic:ci": "pnpm test:kernel:ci && pnpm test:stdlib:ci",
    "verify:static": "pnpm format:check && pnpm lint:paths && pnpm lint && pnpm typecheck && pnpm test:deterministic",
    "verify:static:ci": "pnpm format:check && pnpm lint:paths && pnpm lint && pnpm typecheck && pnpm test:eslint && pnpm test:ci-selection",
    "test:ci-selection": "node --test scripts/ci-deterministic-scope.test.mjs scripts/check-frozen-evidence.test.mjs scripts/ci-sparse-checkout.test.mjs scripts/harness/artifact-source-identity.test.mjs",
    "ssg:update": "pnpm --filter @seedlands/web ssg:update",
    "ssg:check": "pnpm --filter @seedlands/web ssg:check",
    "server:headless": "node scripts/server-headless.mjs",
    "preview": "pnpm --filter @seedlands/web preview",
    "prepare": "husky",
    "wasm:simd:build": "node scripts/build-simd-experiment.mjs",
    "rust:check": "node scripts/check-rust-kernel-boundary.mjs",
    "wasm:rust:build": "node scripts/rust-kernel-artifact.mjs --build",
    "wasm:rust:verify": "node scripts/rust-kernel-artifact.mjs",
    "build:packs": "node scripts/build-gameplay-packs.mjs",
    "build:agent": "pnpm --filter @seedlands/agent-server build",
    "agent:dev": "pnpm build:agent && pnpm --filter @seedlands/agent-server start",
    "test:all": "pnpm test:deterministic",
    "test:eslint": "pnpm --filter @seedlands/eslint-plugin test",
    "harness:classic": "node scripts/harness/classic.mjs",
    "bench:runtime": "node scripts/benchmark-window.mjs -- node scripts/harness/runtime-benchmark.mjs",
    "harness:artifact": "node scripts/harness/artifact.mjs",
    "test:classic:headless": "pnpm --filter @seedlands/web test apps/web/tests/integration/runtime/server/composition/overworld-progression-journey.test.ts apps/web/tests/integration/runtime/server/composition/classic-food-health.test.ts apps/web/tests/integration/runtime/server/composition/classic-plank-building.test.ts apps/web/tests/integration/runtime/server/composition/classic-stick-crafting.test.ts apps/web/tests/integration/runtime/server/composition/classic-material-smelting.test.ts apps/web/tests/integration/runtime/server/composition/classic-precious-tools.test.ts apps/web/tests/integration/runtime/server/composition/classic-tool-matrix.test.ts apps/web/tests/integration/runtime/server/composition/classic-building-blocks.test.ts apps/web/tests/integration/runtime/server/composition/classic-shovel-tools.test.ts apps/web/tests/integration/runtime/server/composition/classic-food-chain.test.ts apps/web/tests/integration/runtime/server/composition/classic-hoe-farmland.test.ts apps/web/tests/integration/runtime/server/composition/classic-till-authority.test.ts apps/web/tests/integration/runtime/server/composition/soil-transform-spine.test.ts apps/web/tests/integration/runtime/server/composition/item-interaction-spine.test.ts apps/web/tests/integration/runtime/server/composition/classic-fluid-interactions.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-growth.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-runtime.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-clock.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-authority.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-harvest-authority.test.ts apps/web/tests/integration/runtime/server/composition/classic-crop-support-authority.test.ts apps/web/tests/integration/runtime/server/composition/crop-support-spine.test.ts apps/web/tests/integration/runtime/server/composition/crop-plant-spine.test.ts apps/web/tests/integration/runtime/server/composition/classic-armor.test.ts apps/web/tests/integration/runtime/server/composition/classic-armor-matrix.test.ts apps/web/tests/integration/runtime/server/composition/classic-armor-death-matrix.test.ts apps/web/tests/integration/runtime/server/composition/classic-utility-items.test.ts apps/web/tests/integration/runtime/server/composition/classic-projectiles.test.ts apps/web/tests/integration/runtime/server/composition/classic-species.test.ts apps/web/tests/integration/runtime/server/composition/classic-difficulty-respawn.test.ts apps/web/tests/integration/runtime/server/composition/classic-spawning.test.ts apps/web/tests/integration/runtime/server/composition/classic-fluid-buckets.test.ts apps/web/tests/integration/runtime/server/composition/classic-environment.test.ts apps/web/tests/integration/runtime/server/composition/classic-lighting.test.ts apps/web/tests/integration/runtime/server/composition/classic-final-entities.test.ts apps/web/tests/integration/runtime/server/composition/classic-special-damage.test.ts apps/web/tests/unit/app/player-held-attack.test.ts apps/web/tests/e2e/classic-support/equipment-route-pulse-handoff.test.ts apps/web/tests/unit/app/block-light-rebuild-pump.test.ts apps/web/tests/unit/client/browser-authority-client.test.ts apps/web/tests/unit/client/input-decision-diagnostics.test.ts apps/web/tests/unit/worker/pointer-attack-input-pump.test.ts apps/web/tests/unit/worker/authority-pointer-attack-target.test.ts apps/web/tests/unit/client/browser-pointer-attack.test.ts apps/web/tests/unit/app/browser-worker-session.test.ts apps/web/tests/unit/app/player-input-gates.test.ts apps/web/tests/e2e/classic-support/target-aim.test.ts apps/web/tests/e2e/classic-support/route-aim-render-independence.test.ts apps/web/tests/unit/app/browser-gameplay-fluid-target.test.ts apps/web/tests/e2e/classic-support/equipment-route-corridor-correction.test.ts apps/web/tests/unit/worker/unused-geometry-mesh.test.ts apps/web/tests/unit/worker/geometry-mesh-task.test.ts apps/web/tests/integration/runtime/world/wasm-mesh-equivalence.test.ts apps/web/tests/e2e/classic-support/route-aim-contract.test.ts apps/web/tests/e2e/classic-support/canonical-reporter.test.ts apps/web/tests/e2e/classic-support/door-collision-oracle.test.ts apps/web/tests/e2e/classic-support/door-collision-runner.test.ts apps/web/tests/e2e/classic-support/door-exit-face.test.ts apps/web/tests/e2e/classic-support/door-readiness.test.ts apps/web/tests/e2e/classic-support/equipment-arrival-drift.test.ts apps/web/tests/e2e/classic-support/equipment-arrival-during-aim.test.ts apps/web/tests/e2e/classic-support/equipment-grounded-route.test.ts apps/web/tests/e2e/classic-support/equipment-mining-aim.test.ts apps/web/tests/e2e/classic-support/equipment-pickup-route-refresh.test.ts apps/web/tests/e2e/classic-support/equipment-post-drift-direction.test.ts apps/web/tests/e2e/classic-support/equipment-resource-route.test.ts apps/web/tests/e2e/classic-support/equipment-restore-reference.test.ts apps/web/tests/e2e/classic-support/route-progress.test.ts apps/web/tests/e2e/classic-support/scenario.test.ts apps/web/tests/unit/client/crop-presentation-loader.test.ts apps/web/tests/integration/runtime/server/composition/crop-presentation-authority.test.ts apps/web/tests/unit/app/crop-stage-presenter.test.ts apps/web/tests/unit/client/crop-stage-geometry.test.ts apps/web/tests/unit/app/world-crop-presentation.test.ts apps/web/tests/unit/app/playcanvas-crop-stage-adapter.test.ts apps/web/tests/unit/app/crop-harness-observation.test.ts apps/web/tests/unit/client/frame-cpu-observer.test.ts apps/web/tests/unit/client/authority-receive-wall-observer.test.ts apps/web/tests/unit/client/browser-authority-receive-observation.test.ts apps/web/tests/unit/app/classic-cpu-profile.test.ts apps/web/tests/integration/runtime/server/composition/classic-navigation-registered.test.ts apps/web/tests/integration/runtime/server/composition/navigation-prepared-commit.test.ts apps/web/tests/unit/app/held-item-interaction.test.ts apps/web/tests/integration/runtime/server/composition/navigation-authority.test.ts apps/web/tests/integration/runtime/server/composition/navigation-target-priority.test.ts --maxWorkers=1 apps/web/tests/unit/app/classic-native-trace.test.ts apps/web/tests/unit/app/classic-authority-cpu-profile.test.ts apps/web/tests/integration/runtime/server/ecs-component-snapshot.test.ts",
    "harness:browser:install": "playwright install --no-shell chromium",
    "typecheck:classic": "tsc -p tsconfig.classic-tests.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/openai": "1.5.11",
    "@ls-lint/ls-lint": "2.3.1",
    "@midscene/cli": "^1.12.3",
    "@playwright/test": "1.62.1",
    "@seedlands/cognition-protocol": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "langchain": "1.5.10",
    "pg": "8.23.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "playcanvas": "^2.21.4",
    "svelte": "^5.57.0",
    "tone": "^15.1.22",
    "@seedlands/eslint-plugin": "workspace:*",
    "@seedlands/kernel": "workspace:*",
    "@seedlands/stdlib": "workspace:*",
    "@seedlands/playbook-classic": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,svelte}": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --check"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
