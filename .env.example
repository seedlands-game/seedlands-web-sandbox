# Copy this file to .env. Midscene CLI loads .env from the current working directory.
# Keep .env local; it is ignored by Git.
MIDSCENE_MODEL_BASE_URL="https://api.deepseek.com"
MIDSCENE_MODEL_API_KEY="replace-with-your-DeepSeek-key"
MIDSCENE_MODEL_NAME="deepseek-v4-flash-vision-exp"
MIDSCENE_MODEL_FAMILY="deepseek"

# Local Vite URL used by the YAML smoke script.
VOXEL_SANDBOX_URL="http://127.0.0.1:5173"
