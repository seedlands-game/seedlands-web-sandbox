{
  "name": "@seedlands/agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./resident-host": "./src/node/resident-host.ts"
  },
  "scripts": {
    "build": "pnpm exec esbuild src/node/main.ts --bundle --platform=node --format=esm --external:@langchain/* --external:ws --external:pg --external:langchain --external:deepagents --outfile=dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --config apps/agent-server/vitest.config.ts",
    "test:watch": "pnpm --dir ../.. exec vitest --config apps/agent-server/vitest.config.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/openai": "1.6.2",
    "@seedlands/cognition-protocol": "workspace:*",
    "@seedlands/stdlib": "workspace:*",
    "deepagents": "1.14.1",
    "langchain": "1.5.15",
    "pg": "8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
