{
  "name": "@seedlands/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/app/main.ts"
  },
  "scripts": {
    "build": "pnpm packs:build && pnpm wasm:rust:verify && pnpm ssg:check && pnpm typecheck && vite build",
    "dev": "pnpm packs:build && vite",
    "preview": "vite preview",
    "ssg:check": "node scripts/render-prerendered-start-screen.mjs --check",
    "ssg:update": "node scripts/render-prerendered-start-screen.mjs --write",
    "test": "pnpm --dir ../.. exec vitest run --config apps/web/vitest.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "wasm:rust:verify": "node ../../scripts/rust-kernel-artifact.mjs",
    "packs:build": "node ../../scripts/build-gameplay-packs.mjs --out public/packs",
    "test:watch": "pnpm --dir ../.. exec vitest --config apps/web/vitest.config.ts"
  },
  "dependencies": {
    "@seedlands/cognition-protocol": "workspace:*",
    "@seedlands/kernel": "workspace:*",
    "@seedlands/playbook-classic": "workspace:*",
    "@seedlands/stdlib": "workspace:*",
    "playcanvas": "^2.21.4",
    "svelte": "^5.57.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "26.4.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
