      expect.soft(classicIdentity, `Runtime composition: ${JSON.stringify(composition)}`).toBe(true);
      stageResults.C0 = {
        status: artifact.ok && loadedPack && loadedStampedBytes && packEntryIdentity && classicIdentity ? 'PASS' : 'FAIL',
