+const collisionBoxesForLoadedVoxel = (voxel: number): readonly LocalBox[] => {
+  if (!Number.isInteger(voxel) || voxel < Voxel.Air || voxel > MAX_VOXEL_ID) return collisionBoxesForVoxel(voxel);
