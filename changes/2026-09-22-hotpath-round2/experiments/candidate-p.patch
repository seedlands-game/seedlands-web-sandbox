+/** Counts active dynamic entities from ECS membership without producing entity projections. */
+export function authorityCapacityCounts(
+  world: World,
+  components: EntityComponents,
+  assertAvailable: () => void,
+  isCurrent: (eid: EntityId) => boolean,
+): Readonly<{ entityCount: number; worldItemCount: number }> {
+  assertAvailable();
+  let entityCount = 0;
+  let worldItemCount = 0;
+  for (const eid of query(world, [components.identity, components.lifecycle, components.transform])) {
+    if (!isCurrent(eid)) continue;
+    const type = ecsEntityType(world, components, eid);
+    if (type === 'station') continue;
+    entityCount += 1;
+    if (type === 'world-item') worldItemCount += 1;
+  }
+  return { entityCount, worldItemCount };
+}
+
+export function queryCurrentEntityIds(
+  world: World,
+  components: EntityComponents,
+  filter: EcsEntityQuery,
+  isCurrent: (eid: EntityId) => boolean,
+): EntityId[] {
+  const terms: object[] = [components.identity, components.lifecycle, components.transform];
+  if (filter.type) terms.push(ecsEntityTypeComponent(components, filter.type));
+  return Array.from(query(world, terms))
+    .filter(isCurrent)
+    .sort(
+      (left, right) =>
+        (components.identity.order[left] ?? Number.MAX_SAFE_INTEGER) -
+        (components.identity.order[right] ?? Number.MAX_SAFE_INTEGER),
+    );
+}
