+      EQUIPMENT_RESOURCE_ROUTE_OPTIONS.tolerance,
+      EQUIPMENT_RESOURCE_ROUTE_OPTIONS.corridorTolerance,
+    )
+  )
+    return { kind: 'drift', snapshot: current };
+  return null;
+}
