+   const deadline = Date.now() + CLOSED_DOOR_INPUT_BUDGET_MS;
+   let assessment = assessClosedDoorProbe(plan, before, observations);
+   await page.keyboard.down('KeyW');
+   try {
+     while (
+       assessment.status === 'pending' &&
+       Date.now() < deadline &&
