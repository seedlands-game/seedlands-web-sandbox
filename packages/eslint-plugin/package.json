{
  "name": "@seedlands/eslint-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./config": "./src/config.mjs"
  },
  "scripts": {
    "build": "node --input-type=module --eval \"await import('./src/index.mjs'); await import('./src/config.mjs')\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "typescript-eslint": "^8.69.0"
  },
  "peerDependencies": {
    "eslint": "^10.9.1"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@types/node": "26.4.1"
  }
}
